# ============================================================
# CIS .gitignore — operator-approved 2026-05-31
# ============================================================

# === Secrets & Environment ===
*.env
.env
*.key
*.pem
*.p12
*.pfx

# === Databases ===
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# === Python ===
__pycache__/
*.py[cod]
*.egg-info/
dist/
/build/
.venv/
venv/

# === Node ===
node_modules/
.pnp/
.pnp.js

# === Archives & Large Data ===
*.tar.gz
*.zip
*.7z
*.rar

# === Models ===
*.gguf
*.bin
*.safetensors
*.pt
*.pth

# === Logs ===
/logs/
*.log

# === Vector DBs ===
chromadb/
*.chroma/

# === IDE & OS ===
.vscode/
.idea/
.DS_Store
Thumbs.db

# === Nested Git ===
**/.git/

# === CIS-Specific Exclusions ===

# Memory (73GB archive — data, not code)
/memory/

# Runtime session / pipeline data
/session_handoffs/
/captures/
/handoff/
/ingest/
/audit/
/drafts/
/knowledge/

# External advisor HCP packet — tracked for cross-model audit (transitional: target generated export Phase F)
# HCP_*.md + READ_FIRST_HERMES_CONTEXT.md are the active external advisor packet
# Non-HCP files in this directory are stale and ignored
/PROJECT_CONTEXT_PACK_UPLOAD/*
!/PROJECT_CONTEXT_PACK_UPLOAD/HCP_*.md
!/PROJECT_CONTEXT_PACK_UPLOAD/READ_FIRST_HERMES_CONTEXT.md

# Generated context packs — DB export previews, not canonical. Do not promote.
/PROJECT_CONTEXT_PACK_GENERATED/
/PROJECT_CONTEXT_PACK_UPLOAD_GENERATED/

# docs: bulky / generated / legacy subdirectories
docs/_archive/
docs/_screenshots/
docs/claude_chat_transcripts/
docs/references/
docs/CIS_Creative_Intelligence_System_v1/

# cis_kernel: extraction pipeline output
cis_kernel/extraction/functional_intents/

# cis_kernel/source: raw transcripts
cis_kernel/source/transcripts/
cis_kernel/source/transcripts_claude/
cis_kernel/source/transcripts_original/

# cis_kernel/source: legacy / superseded
cis_kernel/source/other_docs/
cis_kernel/source/obsidian_vault/
cis_kernel/source/handoffs/
cis_kernel/source/session_logs/
cis_kernel/source/extraction_analyses/

# Screenshots
/Proxmox Screenshots/

# Runtime live / generated files
CIS_LIVE.md
JUDGE REQUEST_*.txt

# Build outputs
/runtime/ui/dist-standalone/
/runtime/ui/dist/

# Log files in source tree
/runtime/cis_lms_log.md

# Raw chat transcripts (not extraction analyses)
docs/architecture_atlas/original_CISChats/

# Explicit database exclusions (no file extension)
/runtime/db/cis_memory_db

# Kanban runtime data (not source code)
# Anchored with /data/* rather than data/ so git still descends into the
# directory — a blanket `data/` exclusion makes any negation below it inert,
# because git never looks inside an excluded directory. Nested data/ dirs
# elsewhere are covered by .venv/ (line 26); none are tracked.
/data/*
!/data/mining_archive/
!/data/mining_archive/**
proposals/

# Runtime live backups (tracked for gateway service recovery)
!/runtime/config/systemd/live_backups/

# Eric Gate generated briefings
runtime/eric_gate/briefings/*.json
20260617_session_files/

# Knowledge-base corpus and exports — data, not code. Lives on disk + ChromaDB.
# Anthropic export moved to /mnt/archive/anthropic_exports/ (2026-06-27)
enforcement/mwl-proof-v2/tagging_input/
enforcement/mwl-proof-v2/tagging_results/
spine_schema.sql.bak
gate_runner_payload.jsonl
hook_payload.jsonl

# SKILL.md split backups (recoverable safety-net, not source — 2026-08-25)
enforcement/mwl-proof-v2/skill-backups-*/

# CLAUDE.md backups (recoverable safety-net, not source — 2026-08-26)
CLAUDE.md.bak.*

# Working backups taken before edits (recoverable safety-net, not source)
*.bak.2*
*.bak2.2*

# Mining archive — evidence base for UNIFIED_BUILD_LIST, must survive.
# The working negation lives beside the /data/* rule above; a negation here
# would be inert because it sits below the parent-directory exclusion.
