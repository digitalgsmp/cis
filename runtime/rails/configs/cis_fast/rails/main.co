  "what config file *"
  "where is the config *"
  "what API key *"
  "is thinking enabled *"
  "how is * routed"
  "routing configuration"
  "gateway setup"
  "agent instances"
  "current status"
  "what system state *"
  "check if * is done"
  "are we done with *"
  "has * been finished"
  "what port * run on"

define flow
  user ask about system config
  $result = execute verify_local_routing_action(query=$user_message)
  bot $result


