# ── Execution & Completion Claims — BLOCKED ────────────────────────────
define user ask to do execution work
  "write a file *"
  "edit a file *"
  "create a file *"
  "make a file *"
  "modify the code *"
  "change the code *"
  "update the code *"
  "patch the file *"
  "run a command *"
  "restart a service *"
  "implement a feature *"
  "deploy to *"
  "commit the code *"
  "push the code *"
  "execute the command *"
  "report PASS on *"
  "report DONE on *"
  "tell Eric it is done"
  "tell Eric I completed"
  "tell me you completed"
  "tell me it is done"
  "completed the code changes"
  "claim it is complete"
  "mark the task done"
  "report that work is done"
  "finished the task *"
  "completed the phase *"
  "the task is complete"
  "all tests pass for *"
  "everything is working now"
  "I have fixed the *"
  "I fixed the *"
  "I built the *"
  "I created the *"
  "I updated the *"
  "I changed the *"

define flow
  user ask to do execution work
  $result = execute block_execution_claim
  bot $result


# ── Catch-All Pass-Through ─────────────────────────────────────────────
# Any message that doesn't match a specific flow above passes through.
# This handles orchestrator directives, system-to-system messages, and
# future prompt variants that haven't been explicitly patterned yet.
# Must be LAST — execution block patterns fire first for actual execution
# claims, then everything else falls through to this.
define user ask anything else
  "*"

define flow
  user ask anything else
  $result = execute pass_through_query(query=$user_message)
  bot $result
