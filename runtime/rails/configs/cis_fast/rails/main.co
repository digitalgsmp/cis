# ── Pass-Through: General Questions ─────────────────────────────────────
# Gate 6C: patterns that are semantically closer to simple questions than
# the guarded flows.  These fire first and pass through to Fast directly.

define user ask general question
  "what is 2+2"
  "what is the capital of"
  "what is the meaning of"
  "how do I"
  "who is"
  "when did"
  "where is"
  "why does"
  "tell me about"
  "explain how"
  "can you explain"
  "I have a question about"
  "do you know"
  "what time is it"
  "what day is it"

define flow
  user ask general question
  $result = execute pass_through_query(query=$user_message)
  bot $result


# ── Pass-Through: Creative & Brainstorming ──────────────────────────────
# Gate 6C: creative/collaborative prompts pass through to Fast.
# These patterns are closer to brainstorming than to execution.

define user ask creative question
  "brainstorm ideas for"
  "brainstorm names for"
  "draft a proposal"
  "write a proposal"
  "draft a directive"
  "draft a final directive"
  "write a directive"
  "draft a FINAL_DIRECTIVE"
  "critique this directive"
  "review this directive"
  "critique the directive"
  "review this for"
  "propose a solution"
  "propose a new"
  "draft a plan"
  "create a plan"
  "design a system"
  "architect a"
  "creative names for"
  "help me name"
  "suggest names for"
  "what should I call"
  "generate ideas for"
  "come up with names"
  "think of some names"
  "give me some ideas"
  "help me brainstorm"
  "let us discuss"
  "can we talk about"
  "what do you think about"
  "I want to explore"
  "SPINE_RUN_ID *""
  "Review this proposal critically *"
  "REVISION REQUEST *"
  "Original topic: *"

define flow
  user ask creative question
  $result = execute pass_through_query(query=$user_message)
  bot $result


# ── System Configuration Queries ───────────────────────────────────────
