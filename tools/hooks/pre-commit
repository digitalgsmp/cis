#!/bin/bash
# CIS pre-commit hook — regenerates HCP + AGENTS.md from spine, blocks commits
# with stale exports, and stages exactly the files this run produced.
#
# Tier 5.x — Export freshness enforcement
# Installed at: .git/hooks/pre-commit  (install: cp tools/hooks/pre-commit .git/hooks/pre-commit)
#
# WB1-D13. This hook used to regenerate in place and then `git add` every
# export path that looked dirty. It could not tell "this run wrote it" from
# "the author was midway through editing it", so an unrelated commit could
# destroy uncommitted work and absorb the replacement — and it would happily
# run a generator whose own source had weeks of unreviewed changes.
#
# The safety decisions now live in tools/export/generate_all.py --precommit
# (tracked, testable, and binding on every caller that uses that flag), not in
# this file. generate_all generates to a scratch tree, refuses to proceed from
# unstaged generator source, refuses to overwrite uncommitted work in a
# generated file, and reports the paths it actually produced. This hook stages
# that reported set and nothing else — there is no path list here to drift.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
GENERATE_ALL="$REPO_ROOT/tools/export/generate_all.py"
GATE_EXPORT="$REPO_ROOT/tools/gates/gate_export_agreement.sh"
DB_PATH="$REPO_ROOT/data/cis_memory.db"
RENDER_QUEUE="$REPO_ROOT/tools/queue/render_build_list.py"
BUILD_LIST="docs/UNIFIED_BUILD_LIST.md"

STAGE_LIST="$(mktemp)"
trap 'rm -f "$STAGE_LIST"' EXIT

# ── Check: can we run the generator? ────────────────────────────────────

if [ ! -f "$GENERATE_ALL" ]; then
    echo "WARN: generate_all.py not found — skipping export regeneration"
    echo "  Expected at: $GENERATE_ALL"
    exit 0
fi

if [ ! -f "$DB_PATH" ]; then
    echo "WARN: Spine DB not found — skipping export regeneration"
    echo "  Expected at: $DB_PATH"
    exit 0
fi

echo "▸ Regenerating exports from spine..."

# ── Run generate_all.py in pre-commit safety mode ───────────────────────
#
# Not captured into a variable: the safety refusals are the most important
# thing this hook can show an author, and burying them in a subshell that
# `set -e` may kill first is how they get lost.

if ! python3 "$GENERATE_ALL" --db "$DB_PATH" --precommit --stage-list "$STAGE_LIST"; then
    echo ""
    echo "═══════════════════════════════════════════════════════════"
    echo "  COMMIT BLOCKED: Export generation refused or FAILED"
    echo "═══════════════════════════════════════════════════════════"
    echo ""
    echo "See the reason above. Nothing in the working tree was modified"
    echo "and nothing was staged."
    echo ""
    exit 1
fi

# ── Render the build list from the queue table ──────────────────────────
#
# Unlike the export projections this one is rendered in place, so it gets the
# same pre-existing-work check applied by hand: if the author already had
# uncommitted changes there, refuse rather than overwrite them.

if [ -f "$RENDER_QUEUE" ]; then
    if ! git diff --quiet -- "$BUILD_LIST" 2>/dev/null; then
        echo ""
        echo "═══════════════════════════════════════════════════════════"
        echo "  COMMIT BLOCKED: uncommitted work in $BUILD_LIST"
        echo "═══════════════════════════════════════════════════════════"
        echo ""
        echo "That file is generated from queue_items and would be overwritten."
        echo "Commit, stash, or discard the change deliberately, then retry."
        echo ""
        exit 1
    fi
    RENDER_OUTPUT=$(python3 "$RENDER_QUEUE" 2>&1) || {
        echo ""
        echo "═══════════════════════════════════════════════════════════"
        echo "  COMMIT BLOCKED: build-list render FAILED"
        echo "═══════════════════════════════════════════════════════════"
        echo "$RENDER_OUTPUT"
        echo ""
        echo "The queue markdown could not be regenerated from queue_items."
        echo "Fix the error above and try again."
        echo ""
        exit 1
    }
    echo "$RENDER_OUTPUT" | tail -2
    if ! git diff --quiet -- "$BUILD_LIST" 2>/dev/null; then
        echo "$BUILD_LIST" >> "$STAGE_LIST"
    fi
fi

# ── Run export agreement gate (if present) ──────────────────────────────

if [ -x "$GATE_EXPORT" ]; then
    echo "▸ Running export agreement gate..."
    if ! bash "$GATE_EXPORT" 2>&1; then
        echo ""
        echo "═══════════════════════════════════════════════════════════"
        echo "  COMMIT BLOCKED: Export agreement gate FAILED"
        echo "═══════════════════════════════════════════════════════════"
        echo ""
        echo "Generated exports did not pass the agreement gate."
        echo "See output above for specific failures."
        echo ""
        exit 1
    fi
fi

# ── Stage exactly what this run produced ────────────────────────────────
#
# The set comes from generate_all, which already proved each path was either
# clean before the run or differed only by its own generation stamp. Untracked
# paths are skipped: a generated file git has never seen is not something a
# hook should silently add to someone's commit.

STAGED_COUNT=0
while IFS= read -r path; do
    [ -n "$path" ] || continue
    if git ls-files --error-unmatch "$path" >/dev/null 2>&1; then
        git add -- "$path"
        STAGED_COUNT=$((STAGED_COUNT + 1))
        echo "▸ staged: $path"
    else
        echo "▸ NOT staged (untracked generated file): $path"
    fi
done < "$STAGE_LIST"

if [ $STAGED_COUNT -gt 0 ]; then
    echo "▸ Auto-staged ${STAGED_COUNT} regenerated export file(s)"
else
    echo "▸ No export file changed; nothing auto-staged"
fi

echo "▸ Exports current ✓"

exit 0
