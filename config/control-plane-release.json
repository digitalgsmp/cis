    {"source": "enforcement/mwl-proof-v2/profiles/evaluator.yaml", "destination": "runtime/profiles/evaluator.yaml", "mode": "0444"},
    {"source": "enforcement/mwl-proof-v2/profiles/menter.yaml", "destination": "runtime/profiles/menter.yaml", "mode": "0444"},
    {"source": "enforcement/mwl-proof-v2/profiles/review1.yaml", "destination": "runtime/profiles/review1.yaml", "mode": "0444"},
    {"source": "enforcement/mwl-proof-v2/profiles/review2.yaml", "destination": "runtime/profiles/review2.yaml", "mode": "0444"},
    {"source": "enforcement/mwl-proof-v2/profiles/verify.yaml", "destination": "runtime/profiles/verify.yaml", "mode": "0444"},
