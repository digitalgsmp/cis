{
  "manifest_version": "cis-control-plane-release-v2",
  "control_root": "/opt/cis-control",
  "artifacts": [
    {"source": "tools/development/control_dispatch.py", "destination": "bin/cis-dispatch", "mode": "0555"},
    {"source": "tools/development/control_dispatch.py", "destination": "bin/control_dispatch.py", "mode": "0444"},
    {"source": "tools/development/control_contract.py", "destination": "bin/cis-contract", "mode": "0555"},
    {"source": "enforcement/mwl-proof-v2/run_container.sh", "destination": "bin/cis-container", "mode": "0555"},
    {"source": "tools/development/gate_host_launch_service.py", "destination": "bin/cis-host-launch-gate", "mode": "0555"},
    {"source": "tools/development/install_host_launch_service.py", "destination": "bin/cis-host-launch-install", "mode": "0555"},
    {"source": "config/dispatch-policy.json", "destination": "policy/dispatch-policy.json", "mode": "0444"},
    {"source": "config/pipeline-image-id.txt", "destination": "policy/pipeline-image-id.txt", "mode": "0444"},
